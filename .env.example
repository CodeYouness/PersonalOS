# PersonalOS environment
#
# Copy to .env.local and fill in. .env* is git-ignored: never commit real
# values, never paste them into a screenshot, never put a key behind a
# NEXT_PUBLIC_ prefix -- that prefix ships the value to the browser.
#
# On a fresh clone every line below is optional. The dashboard runs on seed
# data with none of them set; each one switches on the feature next to it.

# --- Model -------------------------------------------------------------------
# Classifies captures and answers questions. Billed per use and separate from
# any Claude subscription. Set a monthly spend limit the day you create it.
# Without it, capture still works: it falls back to the rule-based classifier.
ANTHROPIC_API_KEY=

# Model name. The code carries a fallback, this variable is the real control.
# Current names: https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=

# --- Time --------------------------------------------------------------------
# The zone that decides when "today" becomes "yesterday". If unset the code
# falls back to Europe/Rome -- never to the server clock, which is UTC and
# would reset your habits at 1am while you are still awake.
USER_TIMEZONE=Europe/Rome

# --- Data --------------------------------------------------------------------
# Where seed.json and personalos.json live. Point it outside the repository if
# you would rather keep your data somewhere else entirely.
DATA_DIR=data

# --- Calendar (guide 5.2) ----------------------------------------------------
# Google Calendar > calendar settings > "Secret address in iCal format".
# This URL is a password: anyone holding it reads your whole calendar.
GOOGLE_CALENDAR_ICAL_URL=

# --- Finance (guide 5.8) -----------------------------------------------------
# Path to an .xlsx or .csv export of your own spreadsheet. Keep it outside the
# repository, or under data/finance/, which is git-ignored.
FINANCE_FILE_PATH=
