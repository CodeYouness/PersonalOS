{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.js", "**/*.jsx", "**/*.mjs"],
  // "**/* *": sync conflict copies ("route 2.js"), as eslint.config.mjs
  // ignores them (#154). Its globs have no "[0-9]", so this is any path with
  // a space -- and no real file in the repository has one.
  "exclude": ["node_modules", ".next", "out", "build", "**/* *"]
}
